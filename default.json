{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "UTC",
  "assignees": ["abrosimov"],
  "labels": ["dependencies"],
  "addLabels": ["{{updateType}}", "{{datasource}}"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 30,
  "prHourlyLimit": 25,
  "automerge": true,
  "automergeType": "pr",
  "packageRules": [
    {
      "description": "A major upgrade is a decision, not a refresh, so it waits to be asked for on the dashboard",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "addLabels": ["needs-decision"]
    },
    {
      "description": "Anything that will merge itself says so on the pull request",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "addLabels": ["automerge"]
    }
  ]
}
